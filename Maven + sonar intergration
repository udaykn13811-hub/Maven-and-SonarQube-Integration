6.6 Create EmployeeServiceTest.java
nano src/test/java/com/aa/employee/EmployeeServiceTest.java

package com.aa.employee;

import org.junit.jupiter.api.Test;

import static org.junit.jupiter.api.Assertions.*;

class EmployeeServiceTest {

    @Test
    void testAddEmployee() {

        EmployeeService service = new EmployeeService();

        Employee employee =
                new Employee(101, "Rahul", 50000);

        service.addEmployee(employee);

        assertEquals(1, service.getAllEmployees().size());
    }

    @Test
    void testGetEmployee() {

        EmployeeService service = new EmployeeService();

        Employee employee =
                new Employee(102, "Amit", 60000);

        service.addEmployee(employee);

        assertEquals("Amit",
                service.getEmployee(102).getName());
    }

    @Test
    void testCalculateAnnualSalary() {

        EmployeeService service = new EmployeeService();

        Employee employee =
                new Employee(103, "John", 40000);

        service.addEmployee(employee);

        assertEquals(480000,
                service.calculateAnnualSalary(103));
    }

    @Test
    void testInvalidEmployee() {

        EmployeeService service = new EmployeeService();

        assertThrows(IllegalArgumentException.class,
                () -> service.addEmployee(null));
    }
}

